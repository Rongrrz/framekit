{
  "name": "framekit",
  "version": "0.1.0",
  "private": true,
  "description": "Roblox-inspired TypeScript UI primitives for the browser DOM.",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test:all && npm run build:all",
    "dev": "vite --config playground/vite.config.ts",
    "build": "npm run build:library",
    "build:all": "npm run build:library && npm run build:playground",
    "build:library": "tsc -b tsconfig.app.json tsconfig.node.json && vite build && tsc -p tsconfig.build.json",
    "build:playground": "tsc -b playground/tsconfig.json tsconfig.node.json && vite build --config playground/vite.config.ts",
    "watch": "tsc -b tsconfig.app.json tsconfig.node.json && vite build --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:all": "npm test && npm run test:playground",
    "test:playground": "vitest run --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^24.12.2",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  }
}
